{
  "name": "reelbox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node tools/publish.mjs",
    "preview": "vite preview",
    "start": "node dist/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build",
    "test:engine": "node tools/build-engine-fixture.mjs && node tools/engine-check.mjs",
    "test:api": "node tools/build-api-fixture.mjs && node tools/api-check.mjs",
    "test": "node tools/frame-check.mjs && node tools/gesture-check.mjs && node tools/build-engine-fixture.mjs && node tools/build-api-fixture.mjs && node tools/api-check.mjs && node tools/store-check.mjs && node tools/engine-check.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.169.5",
    "@tanstack/react-start": "^1.169.5",
    "hls.js": "^1.7.4",
    "lucide-react": "0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}